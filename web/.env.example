# Networks offered in the UI. First one is the default. "aevum" for the real testnet.
NEXT_PUBLIC_NETWORKS=aevum,fork,local

# Deployed contract addresses (set after `make deploy-aevum`)
NEXT_PUBLIC_REGISTRY_AEVUM=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_POLICY_AEVUM=0x0000000000000000000000000000000000000000
NEXT_PUBLIC_DEPLOY_BLOCK_AEVUM=0

# Local fork / anvil addresses (from `make deploy-fork` / `make deploy-local`)
NEXT_PUBLIC_REGISTRY_FORK=
NEXT_PUBLIC_POLICY_FORK=
NEXT_PUBLIC_DEPLOY_BLOCK_FORK=
NEXT_PUBLIC_REGISTRY_LOCAL=
NEXT_PUBLIC_POLICY_LOCAL=

# Optional WalletConnect QR support (extension wallets work without it)
NEXT_PUBLIC_WC_PROJECT_ID=

NEXT_PUBLIC_REPO_URL=https://github.com/PhiBao/ledgerly
